<rect x="106" y="590" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<g data-tex="X_l" data-label="" data-x="140" data-y="611" data-size="21" data-anchor="middle" data-color="#252525"/>
<path class="wire" d="M140 634H350V579"/>
<path d="M140 618V634" stroke="#343434" stroke-width="1.8" fill="none"/>
<text x="260" y="675" text-anchor="middle" font-size="17" font-weight="400" style="fill:#5b6d67">同一个 token 的多路残差</text>
<path class="wire" d="M140 634V709H192"/>
<rect x="192" y="688" width="237" height="76" rx="8" fill="#f2f2f2" stroke="#aab4af"/>
<text x="310" y="711" text-anchor="middle" font-size="16" font-weight="400" style="fill:#262626">由当前残差预测系数</text>
<g data-tex="(A_l,B_l,C_l)=\mathcal{H}(X_l)" data-label="" data-x="310" data-y="744" data-size="20" data-anchor="middle" data-color="#252525"/>
<path class="coef" d="M429 728H511V546H429"/>
<rect x="450" y="591" width="122" height="49" rx="6" fill="#edf5fc" stroke="#94bddb"/>
<text x="511" y="611" text-anchor="middle" font-size="14" font-weight="400" style="fill:#2c75a4">当前预测完成</text>
<g data-tex="A_l" data-label="" data-x="511" data-y="632" data-size="21" data-anchor="middle" data-color="#2c75a4"/>
<text x="487" y="790" text-anchor="middle" font-size="16" font-weight="400" style="fill:#2c75a4">新系数当前子层就用</text>
<g data-tex="B_l,\ C_l" data-label="" data-x="175" data-y="795" data-size="21" data-anchor="middle" data-color="#252525"/>
<text x="175" y="820" text-anchor="middle" font-size="16" font-weight="400" style="fill:#5b6d67">两者都供当前子层使用</text>
</g>
<g transform="translate(600 0)">
<text x="300" y="33" text-anchor="middle" font-size="27" font-weight="650" style="fill:#262626">Single-Pass mHC</text>
<text x="300" y="63" text-anchor="middle" font-size="17" font-weight="400" style="fill:#5b6d67">使用上一子层准备的输入混合系数</text>
<rect x="18" y="85" width="564" height="565" rx="18" fill="#f2f2f2" stroke="none"/>
<text x="40" y="114" text-anchor="start" font-size="16" font-weight="650" style="fill:#262626">当前子层 · 局部展开</text>
<rect x="115" y="134" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<rect x="112" y="137" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<rect x="109" y="140" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<rect x="106" y="143" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<g data-tex="X_{l+1}" data-label="" data-x="140" data-y="164" data-size="21" data-anchor="middle" data-color="#252525"/>
<circle cx="140" cy="224" r="14" fill="white" stroke="#343434" stroke-width="1.5"/>
<g data-tex="+" data-label="" data-x="140" data-y="231" data-size="24" data-anchor="middle" data-color="#252525"/>
<path class="wire" d="M140 210V171"/>
