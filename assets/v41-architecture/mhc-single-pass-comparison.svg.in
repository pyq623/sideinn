<rect x="271" y="247" width="158" height="64" rx="5" fill="#fff0e3" stroke="#c78953"/>
<text x="350" y="270" text-anchor="middle" font-size="17" font-weight="400" style="fill:#262626">Post Mapping</text>
<g data-tex="C_l" data-label="" data-x="350" data-y="298" data-size="23" data-anchor="middle" data-color="#252525"/>
<path class="wire" d="M350 515V492"/>
<path class="wire" d="M350 464V431"/>
<path class="wire" d="M350 387V355"/>
<path class="wire" d="M350 327V311"/>
<path class="wire" d="M350 247V224H154"/>
<rect x="115" y="581" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
<rect x="112" y="584" width="68" height="28" rx="3" fill="#e5e5e5" stroke="#aaa"/>
