[{"number":1,"title":"系统状态","wide":"S_t=\\left(\\theta_t,H_t,M_t,D_t,U_t,G_t\\right)","narrow":"S_t=\\left(\\theta_t,H_t,M_t,D_t,U_t,G_t\\right)"},{"number":2,"title":"提出并应用候选修改","wide":"\\begin{aligned}\\Delta_t&\\sim I_t\\!\\left(\\,\\cdot\\mid S_t,F_t,B_t\\right),\\\\ S'_t&=\\operatorname{Apply}(S_t,\\Delta_t).\\end{aligned}","narrow":"\\begin{aligned}\\Delta_t&\\sim I_t\\!\\left(\\,\\cdot\\mid S_t,F_t,B_t\\right),\\\\ S'_t&=\\operatorname{Apply}(S_t,\\Delta_t).\\end{aligned}"},{"number":3,"title":"接受或回滚","wide":"S_{t+1}=\\begin{cases}S'_t,&\\text{接受条件成立},\\\\ S_t,&\\text{否则}.\\end{cases}","narrow":"S_{t+1}=\\begin{cases}S'_t,&\\text{接受条件成立},\\\\ S_t,&\\text{否则}.\\end{cases}"},{"number":4,"title":"独立测试质量","wide":"\\begin{aligned}Q_*(S;D^{\\mathrm{test}})&=\\mathbb E_{\\substack{x\\sim D^{\\mathrm{test}}\\\\ \\tau\\sim\\pi_S(\\cdot\\mid x)}}\\!\\left[E_*(x,\\tau)\\right].\\end{aligned}","narrow":"\\begin{aligned}&Q_*(S;D^{\\mathrm{test}})\\\\ &\\quad=\\mathbb E_{\\substack{x\\sim D^{\\mathrm{test}}\\\\ \\tau\\sim\\pi_S(\\cdot\\mid x)}}\\!\\left[E_*(x,\\tau)\\right].\\end{aligned}"},{"number":5,"title":"本次任务的修订","wide":"\\begin{aligned}f^{(j)}&=\\operatorname{Critique}\\!\\left(x,y^{(j)},\\text{外部执行结果}\\right),\\\\ y^{(j+1)}&\\sim p_{\\theta_t}\\!\\left(\\,\\cdot\\mid x,y^{(j)},f^{(j)}\\right).\\end{aligned}","narrow":"\\begin{aligned}f^{(j)}&=\\operatorname{Critique}\\!\\bigl(\\\\ &\\quad x,y^{(j)},\\text{外部执行结果}\\bigr),\\\\ y^{(j+1)}&\\sim p_{\\theta_t}\\!\\bigl(\\\\ &\\quad \\cdot\\mid x,y^{(j)},f^{(j)}\\bigr).\\end{aligned}"},{"number":6,"title":"候选持久记忆","wide":"M'_t=\\operatorname{Write}\\!\\left(M_t,\\operatorname{Summarize}(\\tau,\\text{反馈})\\right).","narrow":"\\begin{aligned}M'_t=\\operatorname{Write}\\!\\bigl(&M_t,\\\\ &\\operatorname{Summarize}(\\tau,\\text{反馈})\\bigr).\\end{aligned}"},{"number":7,"title":"生成与筛选","wide":"\\begin{aligned}y_k&\\sim p_{\\theta_t}(\\cdot\\mid x),\\\\ D_t^{\\mathrm{syn}}&=\\left\\{(x,y_k):V(x,y_k)=1\\right\\}.\\end{aligned}","narrow":"\\begin{aligned}y_k&\\sim p_{\\theta_t}(\\cdot\\mid x),\\\\D_t^{\\mathrm{syn}}&=\\bigl\\{(x,y_k):\\\\ &\\qquad V(x,y_k)=1\\bigr\\}.\\end{aligned}"},{"number":8,"title":"监督微调","wide":"\\begin{aligned}\\mathcal L_{\\mathrm{SFT}}(\\theta)&=-\\mathbb E_{(x,y)\\sim D_t^{\\mathrm{syn}}}\\!\\left[\\sum_{j=1}^{L_y}\\log p_\\theta(y_j\\mid x,y_{<j})\\right],\\\\ \\theta'_t&=\\theta_t-\\eta\\left.\\nabla_\\theta\\mathcal L_{\\mathrm{SFT}}(\\theta)\\right|_{\\theta=\\theta_t}.\\end{aligned}","narrow":"\\begin{aligned}&\\mathcal L_{\\mathrm{SFT}}(\\theta)\\\\ &=-\\mathbb E_{(x,y)\\sim D_t^{\\mathrm{syn}}}\\!\\Bigl[\\\\ &\\qquad \\sum_{j=1}^{L_y}\\log p_\\theta(y_j\\mid x,y_{<j})\\Bigr],\\\\ &\\theta'_t=\\theta_t\\\\ &\\qquad-\\eta\\left.\\nabla_\\theta\\mathcal L_{\\mathrm{SFT}}(\\theta)\\right|_{\\theta=\\theta_t}.\\end{aligned}"},{"number":9,"title":"DPO 损失","wide":"\\begin{aligned}d_\\theta(x,y^+,y^-)&=\\log\\frac{p_\\theta(y^+\\mid x)}{p_{\\mathrm{ref}}(y^+\\mid x)}-\\log\\frac{p_\\theta(y^-\\mid x)}{p_{\\mathrm{ref}}(y^-\\mid x)},\\\\ \\mathcal L_{\\mathrm{DPO}}(\\theta)&=-\\mathbb E_{(x,y^+,y^-)\\sim D_t^{\\mathrm{pref}}}\\!\\left[\\log\\sigma\\!\\left(\\beta_{\\mathrm{DPO}}\\,d_\\theta(x,y^+,y^-)\\right)\\right].\\\\ \\sigma(z)&=\\frac{1}{1+e^{-z}}.\\end{aligned}","narrow":"\\begin{aligned}&d_\\theta(x,y^+,y^-)\\\\ &=\\log\\frac{p_\\theta(y^+\\mid x)}{p_{\\mathrm{ref}}(y^+\\mid x)}\\\\ &\\quad-\\log\\frac{p_\\theta(y^-\\mid x)}{p_{\\mathrm{ref}}(y^-\\mid x)},\\\\ &\\mathcal L_{\\mathrm{DPO}}(\\theta)\\\\ &=-\\mathbb E_{(x,y^+,y^-)\\sim D_t^{\\mathrm{pref}}}\\!\\Bigl[\\\\ &\\quad\\log\\sigma\\!\\bigl(\\beta_{\\mathrm{DPO}}\\,d_\\theta(x,y^+,y^-)\\bigr)\\Bigr].\\\\ \\sigma(z)&=\\frac{1}{1+e^{-z}}.\\end{aligned}"},{"number":10,"title":"正则化奖励目标","wide":"\\begin{aligned}J_{\\mathrm{RL}}(\\theta)=\\mathbb E_{x\\sim D^{\\mathrm{tr}}}\\!\\Bigl[&\\mathbb E_{y\\sim p_\\theta(\\cdot\\mid x)}r(x,y)\\\\[-2pt]&-\\beta_{\\mathrm{RL}}D_{\\mathrm{KL}}\\!\\left(p_\\theta(\\cdot\\mid x)\\,\\Vert\\,p_{\\mathrm{ref}}(\\cdot\\mid x)\\right)\\Bigr].\\end{aligned}","narrow":"\\begin{aligned}&J_{\\mathrm{RL}}(\\theta)\\\\ &=\\mathbb E_{x\\sim D^{\\mathrm{tr}}}\\!\\Bigl[\\\\ &\\quad\\mathbb E_{y\\sim p_\\theta(\\cdot\\mid x)}r(x,y)\\\\ &\\quad-\\beta_{\\mathrm{RL}}D_{\\mathrm{KL}}\\!\\bigl(\\\\ &\\qquad p_\\theta(\\cdot\\mid x)\\,\\Vert\\,p_{\\mathrm{ref}}(\\cdot\\mid x)\\bigr)\\Bigr].\\end{aligned}"},{"number":11,"title":"组内优势","wide":"\\begin{aligned}r_k&=r(x,y_k),&\\bar r&=\\frac1K\\sum_{k=1}^Kr_k,\\\\ s_r&=\\sqrt{\\frac1K\\sum_{k=1}^K(r_k-\\bar r)^2},&\nA_k&=\\frac{r_k-\\bar r}{s_r+\\varepsilon_{\\mathrm{std}}}.\\end{aligned}","narrow":"\\begin{aligned}r_k&=r(x,y_k),\\\\ \\bar r&=\\frac1K\\sum_{k=1}^Kr_k,\\\\ s_r&=\\sqrt{\\frac1K\\sum_{k=1}^K(r_k-\\bar r)^2},\\\\ A_k&=\\frac{r_k-\\bar r}{s_r+\\varepsilon_{\\mathrm{std}}}.\\end{aligned}"},{"number":12,"title":"token 概率比","wide":"\\begin{aligned}c_{k,j}&=(x,y_{k,<j}),\\\\ \\rho_{k,j}(\\theta)&=\\frac{p_\\theta(y_{k,j}\\mid c_{k,j})}{p_{\\mathrm{old}}(y_{k,j}\\mid c_{k,j})}.\\end{aligned}","narrow":"\\begin{aligned}c_{k,j}&=(x,y_{k,<j}),\\\\ \\rho_{k,j}(\\theta)&=\\frac{p_\\theta(y_{k,j}\\mid c_{k,j})}{p_{\\mathrm{old}}(y_{k,j}\\mid c_{k,j})}.\\end{aligned}"},{"number":13,"title":"GRPO 的正则化裁剪目标","wide":"\\begin{aligned}J_{\\mathrm{GRPO}}(\\theta)=\\mathbb E\\!\\Biggl[&\\frac1K\\sum_{k=1}^K\\frac1{L_k}\\sum_{j=1}^{L_k}\\Bigl\\{\\\\ &\\min\\!\\Bigl[\\rho_{k,j}(\\theta)A_k,\\\\ &\\quad\\operatorname{clip}\\!\\left(\\rho_{k,j}(\\theta),1-\\varepsilon_{\\mathrm{clip}},1+\\varepsilon_{\\mathrm{clip}}\\right)A_k\\Bigr]\\\\ &-\\beta_{\\mathrm{RL}}d_{k,j}(\\theta)\\Bigr\\}\\Biggr],\\\\ d_{k,j}(\\theta)=&D_{\\mathrm{KL}}\\!\\left(p_\\theta(\\cdot\\mid c_{k,j})\\,\\Vert\\,p_{\\mathrm{ref}}(\\cdot\\mid c_{k,j})\\right).\\end{aligned}","narrow":"\\begin{aligned}&J_{\\mathrm{GRPO}}(\\theta)\\\\ &=\\mathbb E\\!\\Biggl[\\frac1K\\sum_{k=1}^K\\frac1{L_k}\\\\ &\\quad\\sum_{j=1}^{L_k}\\Bigl\\{\\min\\!\\Bigl[\\\\ &\\qquad\\rho_{k,j}(\\theta)A_k,\\\\ &\\qquad\\operatorname{clip}\\!\\bigl(\\rho_{k,j}(\\theta),\\\\ &\\qquad\\quad1-\\varepsilon_{\\mathrm{clip}},\\\\ &\\qquad\\quad1+\\varepsilon_{\\mathrm{clip}}\\bigr)A_k\\Bigr]\\\\ &\\qquad-\\beta_{\\mathrm{RL}}d_{k,j}(\\theta)\\Bigr\\}\\Biggr],\\\\ &d_{k,j}(\\theta)\\\\ &=D_{\\mathrm{KL}}\\!\\bigl(p_\\theta(\\cdot\\mid c_{k,j})\\\\ &\\qquad\\Vert\\,p_{\\mathrm{ref}}(\\cdot\\mid c_{k,j})\\bigr).\\end{aligned}"},{"number":14,"title":"课程难度启发式","wide":"\\begin{aligned}u_t(x)&=\\widehat{\\Pr}_t(\\text{成功}\\mid x),\\\\ w_t(x)&=u_t(x)\\left[1-u_t(x)\\right].\\end{aligned}","narrow":"\\begin{aligned}u_t(x)&=\\widehat{\\Pr}_t(\\text{成功}\\mid x),\\\\ w_t(x)&=u_t(x)\\left[1-u_t(x)\\right].\\end{aligned}"},{"number":15,"title":"种群进化","wide":"\\begin{aligned}P'_t&=\\operatorname{Mutate}(P_t;I_t),\\\\ P_{t+1}&=\\operatorname{Select}\\!\\left(P_t\\cup P'_t;D^{\\mathrm{dev}},B\\right).\\end{aligned}","narrow":"\\begin{aligned}P'_t&=\\operatorname{Mutate}(P_t;I_t),\\\\ P_{t+1}&=\\operatorname{Select}\\!\\bigl(\\\\ &\\quad P_t\\cup P'_t;D^{\\mathrm{dev}},B\\bigr).\\end{aligned}"},{"number":16,"title":"自编辑的嵌套结构","wide":"\\begin{aligned}e_t&\\sim p_{\\theta_t}(\\cdot\\mid\\text{新信息或任务示例}),\\\\ \\theta'_t&=U_t\\!\\left(\\theta_t,\\operatorname{Data}(e_t),\\operatorname{Config}(e_t)\\right),\\\\ r_{\\mathrm{edit}}(e_t)&=Q_{\\mathrm{dev}}(S'_t)-Q_{\\mathrm{dev}}(S_t).\\end{aligned}","narrow":"\\begin{aligned}e_t&\\sim p_{\\theta_t}(\\cdot\\mid\\text{新信息或示例}),\\\\ \\theta'_t&=U_t\\!\\bigl(\\theta_t,\\operatorname{Data}(e_t),\\\\ &\\qquad\\operatorname{Config}(e_t)\\bigr),\\\\ r_{\\mathrm{edit}}(e_t)&=Q_{\\mathrm{dev}}(S'_t)\\\\ &\\quad-Q_{\\mathrm{dev}}(S_t).\\end{aligned}"},{"number":17,"title":"元层面的候选修改","wide":"(S'_t,I'_t)=\\operatorname{MetaApply}(S_t,I_t,F_t,B_t).","narrow":"\\begin{aligned}(S'_t,I'_t)=\\operatorname{MetaApply}\\!\\bigl(&S_t,I_t,\\\\ &F_t,B_t\\bigr).\\end{aligned}"},{"number":18,"title":"固定预算下的改进能力","wide":"\\begin{aligned}\\operatorname{Imp}(I;S_0,B)&=\\mathbb E\\!\\left[Q_*\\!\\left(\\operatorname{Improve}(S_0,I,B)\\right)-Q_*(S_0)\\right],\\\\ \\Delta_{\\mathrm{meta}}&=\\operatorname{Imp}(I_{\\mathrm{new}};S_0,B)-\\operatorname{Imp}(I_{\\mathrm{old}};S_0,B).\\end{aligned}","narrow":"\\begin{aligned}&\\operatorname{Imp}(I;S_0,B)\\\\ &=\\mathbb E\\!\\Bigl[Q_*\\!\\bigl(\\\\ &\\quad\\operatorname{Improve}(S_0,I,B)\\bigr)\\\\ &\\quad-Q_*(S_0)\\Bigr],\\\\ &\\Delta_{\\mathrm{meta}}\\\\ &=\\operatorname{Imp}(I_{\\mathrm{new}};S_0,B)\\\\ &\\quad-\\operatorname{Imp}(I_{\\mathrm{old}};S_0,B).\\end{aligned}"}]